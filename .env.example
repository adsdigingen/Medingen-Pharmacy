# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://username:password@localhost:5432/medingen_pharmacy?schema=public"

# Backend Server Settings (NestJS REST API)
NODE_ENV="production"
PORT=3001
CORS_ORIGIN="http://localhost:3000"

# JWT Authentication (HS256 256-bit high-entropy secret, min 32 characters)
JWT_SECRET="your-secure-high-entropy-jwt-secret-here-min-32-chars"
JWT_EXPIRATION_SECONDS=28800

# Cloud Synchronization & Integrations (Optional)
CLOUD_API_URL=""

# Initial Administrator Credentials for explicit manual seeding only (db:seed)
ADMIN_USERNAME="admin"
ADMIN_PASSWORD=""
